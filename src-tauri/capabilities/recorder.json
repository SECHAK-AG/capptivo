{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "recorder",
  "description": "Recorder popover: capture control, mic chunk IPC, overlays, library handoff. No export/fs/dialog.",
  "windows": ["recorder"],
  "permissions": [
    "core:window:allow-start-dragging",
    "allow-list-capture-sources",
    "allow-list-capture-devices",
    "allow-platform-capabilities",
    "allow-check-permissions",
    "allow-request-screen-permission",
    "allow-open-screen-recording-settings",
    "allow-relaunch",
    "allow-recorder-state",
    "allow-start-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-stop-recording",
    "allow-pick-capture-area",
    "allow-show-area-frame-guide",
    "allow-hide-area-frame-guide",
    "allow-begin-mic-file",
    "allow-write-mic-chunk",
    "allow-finish-mic-file",
    "allow-flush-mic-capture",
    "allow-flush-camera-capture",
    "allow-hide-recorder",
    "allow-set-recorder-layout",
    "allow-set-recorder-bar-width",
    "allow-show-camera-preview",
    "allow-hide-camera-preview",
    "allow-dismiss-camera-preview",
    "allow-set-camera-preview-visible",
    "allow-show-annotation-overlay",
    "allow-hide-annotation-overlay",
    "allow-open-library",
    "allow-open-editor"
  ]
}
