{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "recorder",
  "description": "Recorder popover: capture control, camera IPC, overlays, library handoff. No export/fs/dialog.",
  "windows": ["recorder"],
  "permissions": [
    "core:window:allow-start-dragging",
    "allow-list-capture-sources",
    "allow-list-capture-devices",
    "allow-list-microphones",
    "allow-warm-microphone",
    "allow-cool-microphone",
    "allow-platform-capabilities",
    "allow-check-permissions",
    "allow-request-screen-permission",
    "allow-open-screen-recording-settings",
    "allow-relaunch",
    "allow-recorder-state",
    "allow-prepare-window-capture",
    "allow-start-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-set-recording-mic-muted",
    "allow-stop-recording",
    "allow-pick-capture-area",
    "allow-show-area-frame-guide",
    "allow-hide-area-frame-guide",
    "allow-arm-camera-capture",
    "allow-flush-camera-capture",
    "allow-hide-recorder",
    "allow-set-recorder-layout",
    "allow-set-recorder-bar-width",
    "allow-set-recorder-bar-hitbox",
    "allow-recorder-menu-space",
    "allow-set-recorder-menu",
    "allow-set-recorder-menu-live",
    "allow-begin-recorder-drag",
    "allow-end-recorder-drag",
    "allow-show-camera-preview",
    "allow-hide-camera-preview",
    "allow-dismiss-camera-preview",
    "allow-set-camera-preview-visible",
    "allow-show-annotation-overlay",
    "allow-hide-annotation-overlay",
    "allow-open-library",
    "allow-open-editor",
    "allow-check-for-updates",
    "notification:allow-is-permission-granted"
  ]
}
