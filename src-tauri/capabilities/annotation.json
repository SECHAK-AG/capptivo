{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "annotation",
  "description": "Fullscreen ink overlay: hide + pause display-follow while drawing. No export/delete/record.",
  "windows": ["annotation"],
  "permissions": [
    "core:window:allow-hide",
    "core:window:allow-set-ignore-cursor-events",
    "allow-hide-annotation-overlay",
    "allow-set-annotation-display-follow"
  ]
}
