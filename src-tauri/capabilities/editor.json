{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Library + editor shells: project CRUD, captions, export sink, save dialog, export notification, reveal-in-Finder. No recording start/stop.",
  "windows": ["library", "editor:*"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "dialog:allow-save",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "opener:allow-reveal-item-in-dir",
    "allow-get-whisper-model-status",
    "allow-download-whisper-model",
    "allow-delete-whisper-model",
    "allow-generate-captions",
    "allow-list-projects",
    "allow-load-project",
    "allow-ensure-proxy",
    "allow-save-editor-state",
    "allow-rename-project",
    "allow-delete-project",
    "allow-ensure-thumbnail",
    "allow-save-custom-background",
    "allow-list-custom-backgrounds",
    "allow-delete-custom-background",
    "allow-ensure-seekable-recording",
    "allow-check-export-disk-space",
    "allow-begin-export",
    "allow-write-export-chunk",
    "allow-finish-export",
    "allow-abort-export",
    "allow-mux-export-audio",
    "allow-prepare-export-audio",
    "allow-attach-export-audio",
    "allow-remove-temp-file",
    "allow-present-window",
    "allow-open-editor"
  ]
}
