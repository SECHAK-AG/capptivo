{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base capability for the recorder popover and editor windows. Per-window least-privilege can be split out later (recorder gets no fs write scope; editor gets no recording control).",
  "windows": ["recorder", "library", "camera", "annotation", "editor:*", "area-picker", "area-frame"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "core:window:allow-set-position",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:webview:default",
    "core:app:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "notification:default",
    "global-shortcut:default"
  ]
}
