{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capptivo",
  "version": "1.0.0",
  "identifier": "com.capptivo.desktop",
  "build": {
    "beforeDevCommand": "pnpm fetch:ffmpeg && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm fetch:ffmpeg && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: media: http://media.localhost data: blob:",
        "media-src": "'self' asset: media: http://media.localhost blob:",
        "connect-src": "'self' ipc: http://ipc.localhost media: http://media.localhost",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "files": {}
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libpipewire-0.3-0",
          "libpulse0",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libappindicator-gtk3",
          "pipewire-libs",
          "pulseaudio-libs"
        ]
      }
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ]
  }
}
